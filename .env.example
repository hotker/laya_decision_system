# Laya AI 决策系统 — 环境变量配置
# 复制为 .env 并修改：
#   cp .env.example .env

# ─── Laya 服务 ─────────────────────────────────────────
LAYA_BASE_URL=http://localhost:8000
LAYA_TIMEOUT=30
LAYA_MODEL=multilingual
# LAYA_TASK=predict
# LAYA_LANG=zh

# ─── 性能与容错 ────────────────────────────────────────
LAYA_MAX_BATCH_SIZE=100
LAYA_MAX_CONCURRENT_REQUESTS=5
LAYA_RETRY_TIMES=3
LAYA_RETRY_DELAY=1.0
LAYA_RETRY_BACKOFF_FACTOR=2.0

# ─── 输出 ──────────────────────────────────────────────
LAYA_OUTPUT_DIR=./output
LAYA_KEEP_DAYS=30
LAYA_MAX_FILES=100

# ─── 日志 ──────────────────────────────────────────────
LAYA_LOG_LEVEL=INFO
LAYA_LOG_FORMAT=json